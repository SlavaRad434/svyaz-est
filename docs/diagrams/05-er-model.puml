@startuml
!pragma layout smetana
title СвязьЕсть — ER-модель данных
top to bottom direction
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 55
skinparam ranksep 75
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
hide methods
hide stereotypes

entity "Пользователи\nusers" as users {
  id [PK]
  --
  identity_provider
  provider_subject
  role
  created_at
  --
  UNIQUE(identity_provider, provider_subject)
}

entity "Сессии входа\nsessions" as sessions {
  id [PK]
  --
  user_id [FK]
  token_hash
  expires_at
  revoked_at
}

entity "Тестовые сессии\ntest_sessions" as test_sessions {
  id [PK]
  --
  user_id [FK, NULL]
  attempt_id [UNIQUE]
  attempt_token_hash
  accept_until
  method_version
  server_id
  started_at
  expires_at
  traffic_limit_bytes
  status
}

entity "Операторы\noperators" as operators {
  id [PK]
  --
  name
  is_active
}

entity "Наблюдения\nobservations" as observations {
  id [PK]
  --
  attempt_id [UNIQUE]
  author_id [FK, NULL]
  cell_id [INDEX]
  operator_id [FK, NULL]
  kind
  occurred_at
  submitted_at
  environment
  status
}

entity "Детали замера\nmeasurement_details" as measurement_details {
  observation_id [PK, FK]
  --
  network_type
  transport
  vpn
  download_mbps
  upload_mbps
  rtt_ms
  source
  input_method
  test_session_id [FK, UNIQUE]
  method_version
  metadata_provenance
}

entity "Детали события ошибки\ncomplaint_details" as complaint_details {
  observation_id [PK, FK]
  --
  stage
  method_version
  metadata
  test_session_id [FK, NULL]
  error_code
}

entity "Журнал решений\nmoderation_actions" as moderation_actions {
  id [PK]
  --
  target_type
  observation_id [FK, NULL]
  target_id
  moderator_id [FK, NULL]
  action
  reason
  purge_after [NULL]
  created_at
}

users ||--o{ sessions
users |o--o{ test_sessions
users |o--o{ observations : автор
users ||--o{ moderation_actions : администратор

operators |o--o{ observations
observations ||--o| measurement_details
observations ||--o| complaint_details
observations |o--o{ moderation_actions

note bottom of observations
  Ровно один набор деталей по kind:
  замер ИЛИ событие ошибки (XOR).
  Для замера на карте ячейка обязательна.
  Гостевой author_id = NULL.
  Точные координаты пользователя не хранятся.
  cell_id — текст «версия:столбец:ряд»
  текущей динамической сетки, отдельной
  таблицы ячеек в БД нет. Индекс для
  группировки по ячейкам.
end note

note bottom of moderation_actions
  Единый журнал решений: скрытие и
  восстановление записи администратором,
  удаление вклада или аккаунта владельцем.
  moderator_id = NULL — самоудаление.
  target_type + target_id — полиморфная
  ссылка без FK: журнал нужен и после
  удаления объекта. purge_after — срок
  очистки по политике резервных копий.
end note

legend bottom
  Проектная модель; физические типы столбцов пока не заданы.
  PK — первичный ключ; FK — внешний ключ; UNIQUE — уникальность.
  NULL явно отмечен у необязательных связей; полная NULL-модель ещё не задана.
  Кратности: || — ровно 1; o| — 0..1; o{ — 0..N.
  Идемпотентность повторов обеспечивается
  UNIQUE(attempt_id) на наблюдениях, без отдельной таблицы.
  Методика оценки и профили задач — константы кода (packages/domain),
  в БД не хранятся.
endlegend
@enduml
